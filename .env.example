# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.1 Pro Thinking Mode, Gemini 3.8 Flash, Live API)
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB INTEGRATION (Optional for remote repo syncing and PR automation)
GITHUB_ACCESS_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# VERCEL DEPLOYMENT INTEGRATION (Optional for automatic live production deployments)
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# SUPABASE / POSTGRESQL (Optional external persistence layer)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

